# php_config.overrides - answers for main/php_config.h on OpenVMS x86-64 (clang)
# that the Phase 0 probes do not give directly (tools/gen_build.py).
#
# gen_build.py starts from the host configure's php_config.h (same release, same
# options) and decides every #define in it:
#   HAVE_<X>_H                 from the header probe h_<x>_h
#   HAVE_<F>, HAVE_DECL_<F>    from the declared-and-links probe g_<f>
#   anything else              from this file; a host #define that is neither
#                              probed nor listed here stops the build, so no
#                              Linux answer slips through unreviewed.
# Lines: NAME VALUE  # reason      VALUE "-" = undefine; "=" = keep the host's.
# Probe results: docs/PHASE0.md, docs/probes-x86-clang*.txt.

# --- platform identity
PHP_OS "OpenVMS"                      # PHP_OS / PHP_OS_FAMILY
PHP_UNAME "OpenVMS x86-64"            # php_uname() falls back to this
PHP_BUILD_SYSTEM "OpenVMS x86-64 (cross-configured on Linux)"

# --- same on both: language, sizes, PHP's own choices
PHP_CONFIG_H =
ZEND_DLIMPORT =
STDC_HEADERS =
SIZEOF_INT =                          # clang LP64 (r_misc: int 4, long/size_t/off_t 8)
SIZEOF_LONG =
SIZEOF_LONG_LONG =
SIZEOF_OFF_T =
SIZEOF_SIZE_T =
ZEND_DEBUG =
ZEND_MM_ALIGNMENT =
ZEND_MM_ALIGNMENT_LOG2 =
ZEND_MM_NEED_EIGHT_BYTE_REALIGNMENT =
DEFAULT_SHORT_OPEN_TAG =
PHP_SIGCHILD =
PHP_USE_PHP_CRYPT_R =                 # PHP's bundled crypt
PHP_WRITE_STDOUT -                    # the CLI then writes through stdio: VMS makes every write() to SYS$OUTPUT a record, so var_dump's pieces came out on separate lines
PCRE2_CODE_UNIT_WIDTH =
URI_ENABLE_ANSI =
URI_NO_UNICODE =
HAVE_ALIGNOF =                        # clang
HAVE_ATTRIBUTE_ALIGNED =              # clang
HAVE_ASM_GOTO =                       # probe g_m_asm_goto
HAVE_FPU_INLINE_ASM_X86 =             # x86-64 fnstcw/fldcw, clang inline asm
HAVE_IPV6 =                           # vms-mariadb PHASE0: AF_INET6 dual stack works
HAVE_SOCKLEN_T =                      # probe g_m_socklen_t
HAVE_STRUCT_FLOCK =                   # probe g_m_struct_flock
HAVE_STRUCT_SOCKADDR_STORAGE =        # probe g_m_sockaddr_storage
HAVE_STRUCT_STAT_ST_BLKSIZE =         # probe g_m_st_blksize
HAVE_STRUCT_STAT_ST_BLOCKS =          # probe g_m_st_blocks
HAVE_ST_BLOCKS =
HAVE_STRUCT_STAT_ST_RDEV =            # probe g_m_st_rdev
HAVE_STRUCT_TM_TM_GMTOFF =            # probe g_m_tm_gmtoff
HAVE_STRUCT_TM_TM_ZONE =              # probe g_m_tm_zone
HAVE_TM_ZONE =
HAVE_FUNC_GETHOSTBYNAME_R_6 =         # probe g_m_gethostbyname_r (6 arguments)
HAVE_GETHOSTBYNAME_R =
HAVE_GETIFADDRS =                     # probe g_m_getifaddrs
HAVE_STRERROR_R =                     # probe g_m_strerror_r_posix
HAVE_BUILD_DEFS_H =                   # generated by tools/gen_build.py
HAVE_TIMELIB_CONFIG_H =               # copied from the host configure (no platform facts)
HAVE_PREAD =                          # probe g_m_pread_pwrite
HAVE_PWRITE =
HAVE_DECL_STRERROR_R =                # declared, POSIX form (g_m_strerror_r_posix)
STRERROR_R_CHAR_P -                   # the C RTL's strerror_r returns int, not char *
PHP_HAVE_BUILTIN_CLZ =                # probe g__builtins (all of them compile and link)
PHP_HAVE_BUILTIN_CLZL =
PHP_HAVE_BUILTIN_CLZLL =
PHP_HAVE_BUILTIN_CPU_INIT =
PHP_HAVE_BUILTIN_CPU_SUPPORTS =
PHP_HAVE_BUILTIN_CTZL =
PHP_HAVE_BUILTIN_CTZLL =
PHP_HAVE_BUILTIN_EXPECT =
PHP_HAVE_BUILTIN_FRAME_ADDRESS =
PHP_HAVE_BUILTIN_SADDLL_OVERFLOW =
PHP_HAVE_BUILTIN_SADDL_OVERFLOW =
PHP_HAVE_BUILTIN_SMULLL_OVERFLOW =
PHP_HAVE_BUILTIN_SMULL_OVERFLOW =
PHP_HAVE_BUILTIN_SSUBLL_OVERFLOW =
PHP_HAVE_BUILTIN_SSUBL_OVERFLOW =
PHP_HAVE_BUILTIN_UNREACHABLE =
PHP_HAVE_BUILTIN_USUB_OVERFLOW =

# --- extensions built in (DECISIONS D3)
HAVE_CTYPE =
HAVE_DOM =
HAVE_LEXBOR =
HAVE_LIBXML =
HAVE_MBSTRING =
HAVE_OPENSSL_EXT =
HAVE_PHP_SESSION =
HAVE_SIMPLEXML =
HAVE_XML =
HAVE_XMLREADER =
HAVE_XMLWRITER =
HAVE_ZLIB =
MYSQLND_COMPRESSION_ENABLED =         # zlib
MYSQLND_HAVE_SSL =                    # SSL3 (D7)
MYSQLND_SSL_SUPPORTED =

# --- not on VMS
ENABLE_CHROOT_FUNC -                  # no chroot (g_chroot)
COOKIE_SEEKER_USES_OFF64_T -          # no fopencookie (g_fopencookie)
HAVE_ALLOCA -                         # alloca() does not link (g_alloca); Zend falls back to emalloc
HAVE_CPUID_COUNT -                    # no <cpuid.h>
HAVE_FUNC_ATTRIBUTE_IFUNC -           # ELF ifunc resolvers: no VMS image activator support
HAVE_FUNC_ATTRIBUTE_TARGET -          # per-function ISA targets: kept off with the ifunc dispatch
PHP_HAVE_AVX512_SUPPORTS -            # AVX-512 paths need the above
PHP_HAVE_AVX512_VBMI_SUPPORTS -
HAVE_GCC_GLOBAL_REGS -                # global register variables (HYBRID VM fast path): not in clang
HAVE_HUGE_CODE_PAGES -                # Linux madvise/mremap of the text segment
HAVE_LIBDL =                          # dlopen() links (g_m_dlopen); without it ZEND_EXTENSIONS_SUPPORT is 0 and the built-in opcache's Zend-extension startup never runs (PORTING_LOG); dl() itself stays off by ini (enable_dl)
HAVE_SHM_IPC -                        # System V shm for opcache: use the anonymous mmap (r_mem)
HAVE_SHM_MMAP_POSIX -                 # shm_open: not used
HAVE_SHM_MMAP_ANON =                  # MAP_SHARED|MAP_ANON 128-512 MB works (r_mem)
HAVE_FNMATCH -                        # no <fnmatch.h> (g_m_fnmatch)
HAVE__FPU_SETCW -                     # glibc <fpu_control.h>
MAJOR_IN_SYSMACROS -                  # no <sys/sysmacros.h>
HAVE_LINUX_SOCK_DIAG_H -              # Linux only

# --- provided by vmsport (not the C RTL)
HAVE_SYSLOG_H =                       # vmsport/include/compat/syslog.h + vms_syslog.c (to stderr)
PHP_CAN_SUPPORT_PROC_OPEN -           # no fork (D5)
ZEND_CHECK_STACK_LIMIT -              # zend_call_stack.c has no VMS method; stack > 64 MB (r_zstack)
ZEND_SIGNALS -                        # deferred signal handling off: only SIGALRM is used (D9)

# --- DNS resolver (D21): not in DECC$SHR, so probes g_res_search, g_dn_expand and
# g_dn_skipname (C RTL only) failed; resolv.h maps them to TCPIP$RES_SEARCH etc.,
# exported by TCPIP$IPC_SHR, which BUILD.COM links (probe r_res_search).
# No res_nsearch on VMS: HAVE_RES_NSEARCH stays the probe's (undefined).
HAVE_RES_SEARCH 1
HAVE_DN_EXPAND 1
HAVE_DN_SKIPNAME 1
