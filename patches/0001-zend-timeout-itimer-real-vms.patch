Subject: Zend: max_execution_time on ITIMER_REAL/SIGALRM on OpenVMS

OpenVMS's <signal.h> has no SIGPROF (Zend then defines it as 27, which
the C RTL does not deliver), so max_execution_time never fired.
setitimer(ITIMER_REAL) delivers SIGALRM (vms-php probe r_timer), so use
the real-time timer, as already done for Cygwin, PASE and macOS on Apple
Silicon: wall-clock time counts towards the limit (DECISIONS D9).
---
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -1612,8 +1612,9 @@
 			t_r.it_value.tv_sec = seconds;
 			t_r.it_value.tv_usec = t_r.it_interval.tv_sec = t_r.it_interval.tv_usec = 0;
 
-# if defined(__CYGWIN__) || defined(__PASE__) || (defined(__aarch64__) && defined(__APPLE__))
+# if defined(__CYGWIN__) || defined(__PASE__) || (defined(__aarch64__) && defined(__APPLE__)) || defined(__VMS)
 			// ITIMER_PROF is broken in Apple Silicon system with MacOS >= 14
+			// (OpenVMS has no SIGPROF; ITIMER_REAL delivers SIGALRM)
 			// See https://openradar.appspot.com/radar?id=5583058442911744.
 			setitimer(ITIMER_REAL, &t_r, NULL);
 		}
@@ -1680,7 +1681,7 @@
 
 		no_timeout.it_value.tv_sec = no_timeout.it_value.tv_usec = no_timeout.it_interval.tv_sec = no_timeout.it_interval.tv_usec = 0;
 
-# if defined(__CYGWIN__) || defined(__PASE__) || (defined(__aarch64__) && defined(__APPLE__))
+# if defined(__CYGWIN__) || defined(__PASE__) || (defined(__aarch64__) && defined(__APPLE__)) || defined(__VMS)
 		setitimer(ITIMER_REAL, &no_timeout, NULL);
 # else
 		setitimer(ITIMER_PROF, &no_timeout, NULL);
